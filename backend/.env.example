# ---- AI providers (at least one key) ----
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# GEMINI_CHECK_MODELS=True
# MODEL_CHECK_CACHE_SECONDS=3600
# GEMINI_LIST_MODELS_URL=https://generativelanguage.googleapis.com/v1beta/models
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# AI_TIMEOUT=20
# AI_CONNECT_TIMEOUT=10
# AI_TOTAL_TIME_LIMIT=90
# AI_MODEL_COOLDOWN_SECONDS=120
# AI_MIN_TIME_FOR_ATTEMPT=5
# AI_TEMPERATURE=0.3
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GROQ_MAX_OUTPUT_TOKENS=1024
# AI_PROMPT_FILE=api/prompts/summary.txt
# AI_MAX_CONNECTIONS=20

# ---- Limits ----
# summaries per visitor (IP) per day, 0 = unlimited
SUMMARIES_PER_DAY=0
# THROTTLE_SUMMARIZE=10/min
# THROTTLE_ANON=120/min
# MAX_REQUEST_BODY_BYTES=10240
# CANCEL_FLAG_SECONDS=600

# ---- Scraper ----
# SCRAPER_HTML_PARSER=lxml
# SCRAPER_MAX_URL_LENGTH=2000
# SCRAPER_MAX_TEXT_CHARS=15000
# SCRAPER_MIN_TEXT_CHARS=50
# SCRAPER_MAX_TITLE_CHARS=300
# SCRAPER_FALLBACK_MIN_CHARS=200
# SCRAPER_MAX_DOWNLOAD_BYTES=5242880
# SCRAPER_MAX_REDIRECTS=5
# SCRAPER_ALLOWED_PORTS=80,443,8080,8443
# SCRAPER_TIMEOUT=15
# SCRAPER_CONNECT_TIMEOUT=8
# SCRAPER_TOTAL_TIME_LIMIT=30
# SCRAPER_USER_AGENT=Mozilla/5.0 ...
# SCRAPER_TEXT_TAGS=h1,h2,h3,h4,p,li,blockquote,pre,td
# SCRAPER_IGNORED_TAGS=script,style,noscript,iframe,svg,canvas,form,nav,header,footer,aside,button,template,dialog

# example links shown on the home page, "label|url" separated by ";"
# EXAMPLE_LINKS=Wikipedia: Web scraping|https://en.wikipedia.org/wiki/Web_scraping;MDN: HTTP|https://developer.mozilla.org/en-US/docs/Web/HTTP/Overview

# ---- Django ----
DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECURE_HTTPS=False
# DJANGO_HSTS_SECONDS=2592000
# CORS_ALLOWED_ORIGINS=https://my-frontend.example.com
# NUM_PROXIES=0
# CACHE_DIR=/tmp/ai-web-scraper-cache

# ---- gunicorn (production server) ----
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=150
