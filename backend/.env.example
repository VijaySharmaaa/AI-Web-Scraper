# ---- AI providers ----
# You need at least ONE of these keys. If both are set, Gemini is tried first
# and Groq is used as a fallback when Gemini is rate limited or down.

# Google Gemini - free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq - free key: https://console.groq.com/keys
GROQ_API_KEY=

# optional: which models to try, in order (comma separated)
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# ---- Django ----
# True for local development, False in production
DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# only if the frontend is hosted on a different domain than the backend
# CORS_ALLOWED_ORIGINS=https://my-frontend.vercel.app

# rate limits per IP
# THROTTLE_SUMMARIZE=10/min
